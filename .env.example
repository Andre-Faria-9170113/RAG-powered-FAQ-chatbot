# Keep this file safe on your own computer. Never commit your real key.
OPENAI_API_KEY=

# This is a default. It can be changed in a local .env file.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning for the FAQ vector search.
TOP_K=4
MIN_SIMILARITY=0.35

# Summarize model context after this many complete user/assistant exchanges.
# Must be at least 3. The visible chat transcript is kept separately.
HISTORY_MAX_TURNS=5
