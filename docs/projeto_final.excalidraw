    {
      "id": "Ax1S6YXbkkujCEREz-B87",
      "type": "text",
      "x": -881.5183520750431,
      "y": -1631.8310840028626,
      "width": 426.93817138671875,
      "height": 401.0305417422443,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
